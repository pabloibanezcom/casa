# Copy to .env.local (never commit it). In Vercel, set the same keys in Project Settings.

# Home Assistant public URL (used by the browser for OAuth/WebSocket and by the
# backend to validate users' HA access tokens).
NEXT_PUBLIC_HA_URL=https://your-ha-instance.example.com

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=casa

# Google Calendar (OAuth client from Google Cloud Console, "Web application" type).
# Authorized redirect URIs: http://localhost:3000/api/google/callback and https://<your-vercel-domain>/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated calendar IDs ("primary" works)
GOOGLE_CALENDAR_IDS=primary

# 32-byte key, base64. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Guards the one-off /api/google/connect flow. Generate with: openssl rand -hex 16
SETUP_SECRET=

# Optional: rooms to list first on the panel, comma-separated and in order. The rest follow alphabetically.
NEXT_PUBLIC_ROOM_ORDER=

# Optional: control labels to list first inside each room, comma-separated and in order ("Principal" is always first).
NEXT_PUBLIC_CONTROL_ORDER=

# Optional: covers that report their position backwards (comma-separated entity ids). Can still be flipped per device in the blind panel.
NEXT_PUBLIC_INVERTED_COVERS=
